# ── Conexão da APLICAÇÃO (usada em runtime pelo Next) ──────────────
# Transaction pooler do Supabase (porta 6543). Bom para serverless.
# Supabase → botão "Connect" → Connection string → Transaction pooler.
DATABASE_URL="postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-1-sa-east-1.pooler.supabase.com:6543/postgres"

# ── Conexão para MIGRAÇÕES (usada só pelo db:push) ─────────────────
# Session pooler / conexão direta (porta 5432). O db:push trava na
# porta 6543, por isso ele usa esta.
# Supabase → botão "Connect" → Connection string → Session pooler.
DIRECT_URL="postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-1-sa-east-1.pooler.supabase.com:5432/postgres"

# ── Autenticação (Supabase Auth) ────────────────────────────────
# Supabase → Project Settings → API → Project URL / anon public key
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sua-chave-anon-publica"

# E-mail que, ao se cadastrar, já entra aprovado e como admin —
# é assim que o primeiro administrador da plataforma é criado.
ADMIN_EMAIL_INICIAL="seu-email@exemplo.com"
